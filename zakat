<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حاسبة زكاة الفطر | برادعي عبدالرحمن</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1b4332;
            --secondary-color: #d4af37;
            --bg-color: #f4f7f6;
            --white: #ffffff;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg-color);
            margin: 0; padding: 0;
            display: flex; flex-direction: column; min-height: 100vh;
        }

        header {
            background: var(--primary-color);
            color: var(--white);
            padding: 25px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .main-wrapper {
            display: flex;
            max-width: 1200px;
            margin: 20px auto;
            width: 95%;
            gap: 20px;
            flex-wrap: wrap; /* لضمان التوافق مع الجوال */
        }

        /* القائمة الجانبية */
        .sidebar {
            flex: 1;
            min-width: 250px;
            background: var(--white);
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            height: fit-content;
        }

        .tab-btn {
            width: 100%; padding: 15px; border: none; background: none;
            text-align: right; font-family: 'Tajawal'; font-size: 1rem;
            cursor: pointer; border-bottom: 1px solid #eee; transition: 0.3s;
        }

        .tab-btn.active {
            background: var(--primary-color); color: var(--white);
            border-right: 5px solid var(--secondary-color);
        }

        /* المحتوى */
        .content-area { flex: 3; min-width: 300px; }

        .tab-content {
            background: var(--white); padding: 30px;
            border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: none; /* مخفي افتراضياً */
        }

        .tab-content.active { display: block; } /* يظهر فقط النشط */

        /* الحديث والحاسبة */
        .hadith-box {
            background: #fdfbf4; border-right: 6px solid var(--secondary-color);
            padding: 20px; margin-bottom: 20px; text-align: center; border-radius: 10px;
        }

        .calculator-card { border: 1px solid #e0e0e0; padding: 20px; border-radius: 15px; }

        .members-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px; margin: 20px 0;
        }

        .member-box { background: #f9f9f9; padding: 15px; border-radius: 10px; border: 1px solid #eee; }

        select { width: 100%; padding: 8px; margin-top: 5px; font-family: 'Tajawal'; }

        .results-summary {
            background: #f0f4f2; padding: 20px; border-radius: 10px;
            border: 2px solid var(--primary-color);
        }

        .summary-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #ddd; }

        .print-btn {
            background: var(--secondary-color); color: #000; border: none;
            padding: 12px; width: 100%; border-radius: 8px; font-weight: bold;
            cursor: pointer; margin-top: 15px; font-family: 'Tajawal';
        }

        footer {
            text-align: center; padding: 20px; background: #eee;
            margin-top: auto; font-weight: bold;
        }

        /* التنسيق عند الطباعة */
        @media print {
            .sidebar, header, .print-btn, .input-group, .members-grid, .hadith-box { display: none !important; }
            .tab-content { display: none !important; }
            #calc-tab.active { display: block !important; }
            .results-summary { border: none; width: 100%; }
            body { background: white; }
        }
    </style>
</head>
<body>

<header>
    <h1>بوابة زكاة الفطر الإلكترونية</h1>
</header>

<div class="main-wrapper">
    <div class="sidebar">
        <button class="tab-btn active" onclick="openTab(event, 'calc-tab')">🧮 حاسبة المقادير</button>
        <button class="tab-btn" onclick="openTab(event, 'info1')">1. مفهوم الزكاة</button>
        <button class="tab-btn" onclick="openTab(event, 'info2')">2. الحكمة منها</button>
        <button class="tab-btn" onclick="openTab(event, 'info3')">3. الحكم والوجوب</button>
        <button class="tab-btn" onclick="openTab(event, 'info4')">4. مقدارها</button>
        <button class="tab-btn" onclick="openTab(event, 'info5')">5. وقت الإخراج</button>
        <button class="tab-btn" onclick="openTab(event, 'info6')">6. لمن تعطى؟</button>
        <button class="tab-btn" onclick="openTab(event, 'info7')">7. قصص وعبر</button>
    </div>

    <div class="content-area">
        <div id="calc-tab" class="tab-content active">
            <div class="hadith-box">
                <p><strong>حديث نبوي:</strong> "فَرَضَ رَسُولُ اللَّهِ ﷺ زَكَاةَ الْفِطْرِ طُهْرَةً لِلصَّائِمِ مِنَ اللَّغْوِ وَالرَّفَثِ وَطُعْمَةً لِلْمَسَاكِينِ"</p>
            </div>
            
            <div class="calculator-card">
                <h3>🧮 حاسبة الزكاة المخصصة</h3>
                <div class="input-group">
                    <label>عدد أفراد الأسرة: </label>
                    <input type="number" id="numMembers" value="1" min="1" oninput="initCalculator()" style="width: 60px; padding: 5px;">
                </div>

                <div id="membersGrid" class="members-grid"></div>

                <div class="results-summary">
                    <h4 style="text-align: center; margin-top: 0;">📊 القائمة الإجمالية للإخراج</h4>
                    <div id="totalsList"></div>
                    <button class="print-btn" onclick="window.print()">🖨️ طباعة القائمة للتبضع</button>
                </div>
            </div>
        </div>

        <div id="info1" class="tab-content"><h2>مفهوم زكاة الفطر</h2><p>هي صدقة واجبة بمناسبة الفطر من رمضان طهرة للصائم ومواساة للفقير.</p></div>
        <div id="info2" class="tab-content"><h2>الحكمة منها</h2><p>إغناء الفقراء عن السؤال يوم العيد وإدخال السرور عليهم.</p></div>
        <div id="info3" class="tab-content"><h2>الحكم والوجوب</h2><p>فريضة على كل مسلم ملك قوت يومه وليلته فضل عن حاجته.</p></div>
        <div id="info4" class="tab-content"><h2>مقدارها</h2><p>صاع من طعام (حوالي 2.5 إلى 3 كغ) حسب نوع الطعام.</p></div>
        <div id="info5" class="tab-content"><h2>وقت الإخراج</h2><p>من غروب شمس آخر يوم في رمضان إلى ما قبل صلاة العيد.</p></div>
        <div id="info6" class="tab-content"><h2>لمن تعطى؟</h2><p>للفقراء والمساكين من المسلمين.</p></div>
        <div id="info7" class="tab-content"><h2>قصص من السيرة</h2><p>كان الصحابة يخرجونها قبل العيد بيوم أو يومين تحقيقاً للتكافل.</p></div>
    </div>
</div>

<footer>
    صُمم وطُوِّر بواسطة: برادعي عبدالرحمن
</footer>

<script>
    const weights = {
        "1": { name: "الدقيق (السميد)", w: 2000 },
        "2": { name: "القمح", w: 2040 },
        "3": { name: "الفَرينة", w: 1400 },
        "4": { name: "الكسكس", w: 1800 },
        "5": { name: "الحمصة", w: 2000 },
        "6": { name: "التمر", w: 1800 },
        "7": { name: "الأرز", w: 2300 },
        "8": { name: "العدس", w: 2100 },
        "9": { name: "الجلبانة (البازلاء)", w: 2240 },
        "10": { name: "الحمص", w: 2000 },
        "11": { name: "اللوبيا", w: 2060 },
        "12": { name: "الزبيب", w: 1640 }
    };

    function initCalculator() {
        const count = document.getElementById('numMembers').value;
        const grid = document.getElementById('membersGrid');
        grid.innerHTML = '';
        if (count < 1) return;

        for (let i = 1; i <= count; i++) {
            let options = '';
            for (let k in weights) {
                options += `<option value="${k}">${weights[k].name}</option>`;
            }
            grid.innerHTML += `<div class="member-box">فرد ${i}: <select class="sel" onchange="calc()">${options}</select></div>`;
        }
        calc();
    }

    function calc() {
        const selects = document.querySelectorAll('.sel');
        const res = {};
        selects.forEach(s => {
            const item = weights[s.value];
            res[item.name] = (res[item.name] || 0) + item.w;
        });

        const list = document.getElementById('totalsList');
        list.innerHTML = '';
        for (let n in res) {
            list.innerHTML += `<div class="summary-row"><span>${n}</span><b>${(res[n]/1000).toFixed(2)} كغ</b></div>`;
        }
    }

    function openTab(evt, name) {
        const contents = document.getElementsByClassName("tab-content");
        for (let i = 0; i < contents.length; i++) contents[i].classList.remove("active");
        const btns = document.getElementsByClassName("tab-btn");
        for (let i = 0; i < btns.length; i++) btns[i].classList.remove("active");
        document.getElementById(name).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    window.onload = initCalculator;
</script>

</body>
</html>
